# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
ORDERDESK_MODEL=

# PayPal SANDBOX REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's Webhooks section, after subscribing
# https://<your-app>/api/webhooks/paypal to INVOICING.INVOICE.PAID and INVOICING.INVOICE.CANCELLED
PAYPAL_WEBHOOK_ID=
# Optional: the sandbox BUSINESS account email shown as the invoicer
PAYPAL_INVOICER_EMAIL=
# Optional: default billing email for new orders (your sandbox PERSONAL account),
# so the demo invoice can be paid by the sandbox buyer
PAYPAL_BUYER_EMAIL=

# Postgres (Neon). Leave empty for a zero-setup embedded Postgres (PGlite) in ./.data
DATABASE_URL=
